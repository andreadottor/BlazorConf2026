@* Presentational component: receives data via Parameter, notifies via EventCallback *@

<div class="card mb-2 @(IsSelected ? "border-primary shadow-sm" : "")" 
     style="cursor: pointer;" 
     @onclick="OnSelectClicked">
    <div class="card-body d-flex align-items-center gap-3 py-2">
        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" 
             style="width: 40px; height: 40px; font-size: 1.1rem;">
            @User.Name[0]
        </div>
        <div>
            <h6 class="mb-0">@User.Name</h6>
            <small class="text-muted">@User.Email</small>
        </div>
        <span class="badge bg-secondary ms-auto">@User.Role</span>
    </div>
</div>

@code {
    // Only Parameters and EventCallbacks — no internal state, no logic
    [Parameter, EditorRequired] public required Models.User User { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<Models.User> OnSelected { get; set; }

    private async Task OnSelectClicked() => await OnSelected.InvokeAsync(User);
}
